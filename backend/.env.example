PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/crm
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated allowed origins (leave empty to allow all in local dev)
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Background Reminder & Deadline Scheduler
ENABLE_SCHEDULER=true
SCHEDULER_INTERVAL_MS=60000

# Outbound Email (Option 1: Resend API)
RESEND_API_KEY=
EMAIL_FROM=CRM <noreply@yourdomain.com>

# Outbound Email (Option 2: SMTP with nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
